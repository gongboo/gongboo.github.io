#!/bin/sh
set -eu

site_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$site_dir"

# macOS system Ruby is too old for the Jekyll version used for local preview.
for ruby_dir in /opt/homebrew/opt/ruby/bin /usr/local/opt/ruby/bin; do
  if [ -x "$ruby_dir/ruby" ]; then
    PATH="$ruby_dir:$PATH"
    export PATH
    break
  fi
done

if ! command -v bundle >/dev/null 2>&1; then
  echo "Bundler를 찾을 수 없습니다. Homebrew Ruby와 Bundler를 설치해 주세요." >&2
  exit 1
fi

BUNDLE_PATH="$site_dir/vendor/bundle"
BUNDLE_GEMFILE="$site_dir/Gemfile.preview"
export BUNDLE_PATH BUNDLE_GEMFILE

if ! bundle check >/dev/null 2>&1; then
  echo "처음 실행이라 Jekyll 의존성을 설치합니다..."
  bundle install
fi

echo "미리보기 주소: http://127.0.0.1:4000/"
echo "종료하려면 Ctrl+C를 누르세요."
exec bundle exec jekyll serve --livereload "$@"
